<Window x:Class="CS2Soundboard.Views.HotkeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set hotkey" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource Subtle}" Margin="0,6,0,12"
                   Text="Press the key combination you want to use (Ctrl, Alt and Shift can be combined with any key). Press Esc to cancel." />
        <Border Background="White" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="8" Padding="12" Focusable="False">
            <TextBlock x:Name="ComboText" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Text="Waiting for keys..." />
        </Border>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ClearButton" Click="OnClear" Focusable="False">Remove hotkey</Button>
            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Click="OnSave" IsEnabled="False" Focusable="False">Save</Button>
            <Button Click="OnCancel" Margin="0" Focusable="False">Cancel</Button>
        </StackPanel>
    </StackPanel>
</Window>
