<Window x:Class="CS2Soundboard.Views.PushToTalkKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Push-to-talk key" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
    <StackPanel Margin="20">
        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Your CS2 push-to-talk key" />
        <TextBlock Style="{StaticResource Subtle}" Margin="0,6,0,12"
                   Text="Press the key you use for voice chat in CS2 (for example V), or click the mouse button (middle, Mouse 4 or Mouse 5). Press Esc to cancel." />
        <Border x:Name="CaptureArea" Background="White" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="8" Padding="12">
            <TextBlock x:Name="KeyText" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Text="Waiting for a key..." />
        </Border>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Click="OnSave" IsEnabled="False" Focusable="False">Save</Button>
            <Button Click="OnCancel" Margin="0" Focusable="False">Cancel</Button>
        </StackPanel>
    </StackPanel>
</Window>
